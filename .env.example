# =============================================================================
# LinkPulse Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit the .env file to version control.
# =============================================================================

# PostgreSQL credentials (used by both docker-compose and Spring Boot)
POSTGRES_DB=url_shortener_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_to_a_strong_password

# Public-facing base URL for generated short links
APP_BASE_URL=http://localhost

# Optional rate limiting overrides for POST /api/urls (per client IP)
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_MS=60000
